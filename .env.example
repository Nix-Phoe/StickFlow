# Variables de l'app (copier en .env.local, ignoré par git). Aucune clé d'API ici : elles restent
# dans le Worker (secret PEXELS_API_KEY, voir .dev.vars.example et DEPLOY.md).

# Adresse du proxy d'images. Vide (par défaut) : /api sur le même domaine, servi par le Worker
# (en développement, Vite envoie /api/* à `wrangler dev`). À changer seulement pour un autre proxy.
VITE_IMAGE_PROXY_URL=

# Recherche de photos Pexels dans l'onglet Internet : « on » pour la proposer (il faut alors le
# secret PEXELS_API_KEY du Worker). Vide : coupée, l'import par adresse reste disponible.
VITE_STOCK_SEARCH=

# Adresse publique du site, sans « / » final (balises de partage, sitemap.xml, robots.txt).
# Exemple : https://stickflow.<votre-sous-domaine>.workers.dev
SITE_URL=
