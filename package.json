{
  "name": "stickflow",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator",
    "screenshots": "node scripts/screenshots.mjs",
    "dev:api": "wrangler dev --port 8787",
    "preview:worker": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types server/worker-configuration.d.ts && tsc && tsc -p server"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gl-matrix": "^3.4.4",
    "idb-keyval": "^6.3.0",
    "lucide": "^1.61.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.2"
  }
}
